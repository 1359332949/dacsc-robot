  "findings": [
    {
      "id": "S1",
      "evidence": "extract_value_vectors runs layer.mlp.down_proj on one-hot inputs; project_to_vocab_batched multiplies by language_model.lm_head.weight",
      "boundary": "Fixed VLM output directions and vocabulary projection, not dynamic visual activation salience"
    },
    {
      "id": "S2",
      "evidence": "apply_gate_proj_hooks registers a forward hook on down_proj; input[0][...,neuron_ids]=coef then F.linear(weight,bias) returns replacement output",
      "boundary": "Constant overwrite, in-place input mutation, coef1 is not no-op, default flattened indices assume intermediate_size11008; do not reuse as read-only observer or multiplicative gate"
    },
    {
      "id": "S3",
      "evidence": "CoRP Mlp.fc2 is Linear1536to384 with bias; block uses ls2 before residual addition",
      "boundary": "One-hot projection includes shared bias and effective residual write also includes LayerScale; do not label visual directions with T5 vocabulary"
    },
    {
      "id": "S4",
      "evidence": "pi0_extract reads PaliGemma.llm.layers.mlp.linear; VLM/model loaders and existing-file caches are model-specific",
      "boundary": "No DINO/CoRP correspondence; do not mix cache artifacts or assume full JAX intervention audited"
    },
    {
      "id": "A1",
      "evidence": "Pi05Adapter declares expert and paligemma layer groups; OFT Llama layers; SmolVLA groups are layer.mlp; GR00T groups eagle/vlsa/dit",
      "boundary": "Full residual and MLP writes are not interchangeable; no CoRP group or architecture alias assumed"
    },
    {
      "id": "A2",
      "evidence": "ActivationInjectionHook returns original output when stored calls are exhausted or shape mismatches, recording counters",
      "boundary": "Injection must be validated by logical call identity, coverage and mismatches; same shape/call list index alone insufficient for CoRP observations/Euler steps"
    },
    {
      "id": "A3",
      "evidence": "ActivationCollector can preserve tokens or mean-pool; gated mode collects once per step; ReconstructionHook factory distinguishes pertoken_replace/meanpool_replace/meanpool_delta",
      "boundary": "Pooling/writeback/training site must match; do not pool away patch/action positions or merge visual calls with denoising calls"
    },
    {
      "id": "A4",
      "evidence": "ResidualSite hooks full layer output; SmolVLAResidualSite reconstructs r+mlp_output through norm pre-hook and MLP hook",
      "boundary": "Special goal-steering path is distinct from generic adapter MLP-only hooks; no direct transplantation"
    },
    {
      "id": "P1",
      "evidence": "Current CoRP dataset returns style/task/episode/frame but not layout in sample dict; original episode metadata contains layout",
      "boundary": "Real sample manifest must join by original dataset/task/episode rather than assume a missing default"
    },
    {
      "id": "P2",
      "evidence": "Current rank_register_images accepts single-view clean image preprocessing and no shift parameter",
      "boundary": "Real clean/shift capture can be specified but no matched shifted detector path implemented; do not quantize transformed PNG as a shortcut to claiming faithful paired ranking"
    }
  ],
