{
  "experiment": "SOURCE_OBSERVER_V1",
  "version": 1,
  "scope": "gate_A_only",
  "seed": 2014,
  "horizon": 12,
  "views": ["agentview", "eye_in_hand"],
  "pooling": "mean_48_tokens_within_each_view",
  "pca_rank": 8,
  "pca_fit_rows": "unique_boundaries_of_full_fit_chunks",
  "pca_weighting": "equal_state_then_equal_selected_boundary",
  "action_representation": "three_consecutive_4_step_means_21_dimensions",
  "ridge_alpha": 1.0,
  "ridge_objective": "sum_i w_i ||y_i - X_i B - b||^2 + alpha ||B||^2; sum(w)=1",
  "row_weighting": "equal_state_then_equal_full_chunk",
  "feature_scale_floor": 0.000001,
  "target_scale_floor_absolute": 0.000001,
  "target_scale_floor_median_fraction": 0.1,
  "models": {"M0": "state8+actions21", "M1": "pca8+state8+actions21", "M2": "pca8"},
  "untrained_controls": ["zero_delta", "fit_mean_next_minus_current"],
  "bootstrap_seed": 20261121,
  "bootstrap_resamples": 10000,
  "bootstrap_ci": 0.95,
  "cosine_min_true_scaled_norm": 0.1,
  "cosine_min_pred_norm": 1e-12,
  "confound_bins_end_step": [24, 72],
  "nonterminal_min_remaining_steps": 24,
  "fixed_model_action_probe": "within_state_circular_shift_one_full_chunk",
  "continue_gate_each_view": {
    "comparisons": ["M0", "M2"],
    "minimum_median_relative_rmse_gain": 0.05,
    "minimum_state_wins": 8,
    "bootstrap_mean_gain_lower_bound_positive": true,
    "M1_median_gain_vs_each_untrained_control_positive": true,
    "early_common_horizon_end_at_most_72_median_gain_vs_M0_and_M2_positive": true,
    "remaining_more_than_24_median_gain_vs_M0_and_M2_positive": true
  },
  "overall_continue": "both_views_pass_all_conditions",
  "interpretation": "exploratory engineering gate; ten states, one seed, one task; no target-risk or safety claim",
  "forbidden_features": ["elapsed_steps", "remaining_steps", "episode_success", "episode_length", "state_id", "seed"],
  "target_data_allowed": false,
  "validation_refit_allowed": false,
  "hyperparameter_search_allowed": false
}
